# Application
APP_NAME=Agentic Travel Planner
LOG_LEVEL=INFO
API_BASE_URL=http://127.0.0.1:8000

# OpenAI. OPENAI_API_KEYS accepts one or more comma-separated keys.
OPENAI_API_KEYS=sk-your-key-here
# Alternatively, set one key through OPENAI_API_KEY instead.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_MAX_COMPLETION_TOKENS=3200
USE_MOCK_LLM=false

# Travel search. false = try remote MCP providers, then fall back to local MCP mock.
# true = always use local JSON fixtures through the local MCP server.
USE_MOCK_TRAVEL_DATA=false
TRAVEL_SEARCH_MAX_RESULTS=5

# Flight provider: official hosted SerpApi MCP (Google Flights engine).
SERPAPI_API_KEY=
SERPAPI_MCP_URL=https://mcp.serpapi.com/mcp

# Hotel provider: Flightpowers Booking.com MCP connector.
# Direct ad-free endpoint needs RAPIDAPI_KEY. Alternatively replace BOOKING_MCP_URL
# with the connector/gateway URL supplied by Glama; then the gateway may manage auth.
BOOKING_MCP_URL=https://hotels.flightpowers.com/mcp
RAPIDAPI_KEY=

# Safety/cost limits per workflow
MAX_REVISIONS=3
MAX_EXTERNAL_SEARCH_CALLS_PER_PLAN=6

# Local demo memory
USER_MEMORY_PATH=./data/user_memory.json
