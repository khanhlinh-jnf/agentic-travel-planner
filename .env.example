# Application
APP_NAME=Agentic Travel Planner
LOG_LEVEL=INFO
API_BASE_URL=http://127.0.0.1:8000

# OpenAI. OPENAI_API_KEYS accepts one or more comma-separated keys.
OPENAI_API_KEYS=sk-your-key-here
LLM_MODEL=gpt-5.4-mini
LLM_MAX_COMPLETION_TOKENS=1800

# Travel search
# false: OpenAI Web Search first, deterministic mock fallback on any failure.
# true: always use local JSON fixtures (offline demo/tests).
USE_MOCK_TRAVEL_DATA=false
WEB_SEARCH_MODEL=gpt-5.4-mini
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=45

# Safety/cost limits per workflow
MAX_SUPERVISOR_STEPS=8
MAX_REVISIONS=3
MAX_EXTERNAL_SEARCH_CALLS_PER_PLAN=6

# Local demo memory
USER_MEMORY_PATH=./data/user_memory.json

